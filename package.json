{
  "name": "fomo",
  "private": true,
  "version": "0.0.0",
  "description": "Project Fomo — social crypto discovery and trading platform (codename, final name TBD).",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @fomo/db generate",
    "db:migrate:deploy": "pnpm --filter @fomo/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @fomo/db migrate:dev",
    "db:studio": "pnpm --filter @fomo/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
