# Copy to .env for local development (docker compose up -d provides matching DB/Redis).
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://fomo:fomo@localhost:5432/fomo?schema=public
REDIS_URL=redis://localhost:6379

# V1's single chain. Base's own public RPC works with no signup and is fine for local
# dev; it rate-limits under sustained concurrent load, so production should point this at
# a dedicated provider (Alchemy/QuickNode) instead — never commit that URL/key.
CHAIN_IDENTIFIER=eip155:8453
CHAIN_NAME=Base
CHAIN_NATIVE_SYMBOL=ETH
CHAIN_RPC_URL=https://mainnet.base.org

HEARTBEAT_INTERVAL_SECONDS=60
MARKET_INGESTION_INTERVAL_SECONDS=60
