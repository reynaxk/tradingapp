# Copy to .env for local development (docker compose up -d provides matching DB/Redis).
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://fomo:fomo@localhost:5432/fomo?schema=public
REDIS_URL=redis://localhost:6379

# V1's single chain. Get an RPC URL from a provider (Alchemy/QuickNode); never commit one.
CHAIN_IDENTIFIER=eip155:8453
CHAIN_NAME=Base
CHAIN_NATIVE_SYMBOL=ETH
CHAIN_RPC_URL=https://your-rpc-provider.example.com/base-mainnet/REPLACE_ME

HEARTBEAT_INTERVAL_SECONDS=60
