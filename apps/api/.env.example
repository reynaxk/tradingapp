# Copy to .env for local development (docker compose up -d provides matching defaults).
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://fomo:fomo@localhost:5432/fomo?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Generate a real one for anything beyond local dev: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-before-deploying

# Phase 3 trading — see docs/TRADING.md. Must name the same chain
# apps/workers/.env.example's CHAIN_IDENTIFIER already indexes.
CHAIN_ID=8453
CHAIN_RPC_URL=https://mainnet.base.org
# Real quotes require a real key from https://0x.org/docs/introduction/getting-started —
# see docs/TRADING.md#provider. Without one, quote requests fail honestly rather than
# falling back to an invented price.
ZEROEX_API_KEY=replace-with-a-real-0x-api-key
# The wallet address that receives the platform fee — collected atomically by the swap
# transaction itself, never custodied by this backend in between.
PLATFORM_FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
# 50 = 0.50% — see docs/TRADING.md#fees.
PLATFORM_FEE_BPS=50
